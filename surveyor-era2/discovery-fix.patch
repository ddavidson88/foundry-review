+-- Era discovery evidence: exact client messages, saved independently per character.
+local _, ns = ...
+local Discovery = {}
+ns.Discovery = Discovery
+
+-- Compile the client's localized format, including positional %1$s / %2$d.
+local function compile(fmt)
+    if type(fmt) ~= "string" then return end
+    local out, nameCapture, captures, i = { "^" }, nil, 0, 1
+    while i <= #fmt do
+        local ch = fmt:sub(i, i)
+        if ch == "%" then
+            local tail = fmt:sub(i)
+            local token, kind = tail:match("^(%%[12]%$([sd]))")
+            if not token then token, kind = tail:match("^(%%([sd]))") end
+            if token then
+                captures = captures + 1
+                if kind == "s" then
+                    if nameCapture then return end
+                    nameCapture = captures
+                    out[#out + 1] = "(.+)"
+                else
+                    out[#out + 1] = "(%d+)"
+                end
+                i = i + #token
+            elseif tail:sub(1, 2) == "%%" then
+                out[#out + 1] = "%%"
+                i = i + 2
+            else
+                return -- Unsupported format: fail closed.
+            end
+        else
+            out[#out + 1] = ch:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
+            i = i + 1
+        end
+    end
+    out[#out + 1] = "$"
+    if nameCapture then return table.concat(out), nameCapture end
+end
+
+function Discovery.NameFromMessage(message)
+    if type(message) ~= "string" then return end
+    for _, key in ipairs({ "ERR_ZONE_EXPLORED_XP", "ERR_ZONE_EXPLORED" }) do
+        local pattern, index = compile(_G[key])
+        if pattern then
+            local matches = { message:match(pattern) }
+            if matches[index] then return matches[index] end
+        end
+    end
+end
+
+function Discovery.RecordMessage(message)
+    local name = Discovery.NameFromMessage(message)
+    if not name or not ns.Explored then return false end
+    local mapID = C_Map and C_Map.GetBestMapForUnit and C_Map.GetBestMapForUnit("player")
+    local assigned = ns.MapAreas and ns.MapAreas[mapID]
+    -- Require a known current zone; never mark every same-named area worldwide.
+    if not assigned then return false end
+    local root = ns.Grid.RootOf(ns.Areas, assigned) or assigned
+    local candidate
+    for id, row in pairs(ns.Areas or {}) do
+        if (ns.Grid.RootOf(ns.Areas, id) or id) == root then
+            local localized = C_Map.GetAreaInfo and C_Map.GetAreaInfo(id)
+            local areaName = localized or ((not GetLocale or GetLocale() == "enUS" or GetLocale() == "enGB") and row[1])
+            if areaName == name then
+                if candidate then return false end -- Ambiguous name within this zone.
+                candidate = id
+            end
+        end
+    end
+    if not candidate or ns.Explored[candidate] then return false end
+    ns.Explored[candidate] = true
+    if ns.Map then ns.Map.Invalidate() end
+    return true
+end
+
+function Discovery.Start()
+    if Discovery.frame then return end
+    local frame = CreateFrame("Frame")
+    Discovery.frame = frame
+    frame:RegisterEvent("CHAT_MSG_SYSTEM")
+    frame:RegisterEvent("UI_INFO_MESSAGE")
+    frame:SetScript("OnEvent", function(_, event, first, second)
+        local message = first
+        if event == "UI_INFO_MESSAGE" and type(first) ~= "string" then message = second end
+        Discovery.RecordMessage(message)
+    end)
+end
